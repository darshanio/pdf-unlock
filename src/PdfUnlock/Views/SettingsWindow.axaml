<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PdfUnlock.ViewModels"
        xmlns:m="using:PdfUnlock.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="480"
        x:Class="PdfUnlock.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/pdf-unlock.ico"
        Width="720" Height="480" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Title="Settings">

    <Grid ColumnDefinitions="190,*">

        <!-- Navigation rail -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,1,0"
                Padding="10,14">
            <StackPanel Spacing="2">
                <RadioButton GroupName="Section" Content="General" Classes="rail"
                             IsChecked="{Binding IsGeneral, Mode=OneWay}"
                             Command="{Binding SelectCommand}" CommandParameter="General" />
                <RadioButton GroupName="Section" Content="Passwords" Classes="rail"
                             IsChecked="{Binding IsPasswords, Mode=OneWay}"
                             Command="{Binding SelectCommand}" CommandParameter="Passwords" />
                <RadioButton GroupName="Section" Content="qpdf" Classes="rail"
                             IsChecked="{Binding IsQpdf, Mode=OneWay}"
                             Command="{Binding SelectCommand}" CommandParameter="Qpdf" />
                <RadioButton GroupName="Section" Content="Licences" Classes="rail"
                             IsChecked="{Binding IsLicences, Mode=OneWay}"
                             Command="{Binding SelectCommand}" CommandParameter="Licences" />
            </StackPanel>
        </Border>

        <Panel Grid.Column="1">

            <!-- General -->
            <ScrollViewer IsVisible="{Binding IsGeneral}" Padding="22,20">
                <StackPanel Spacing="18">
                    <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="When files are opened from the context menu" FontWeight="Medium" />
                        <RadioButton GroupName="Ctx" Content="Load them and wait for me"
                                     IsChecked="{Binding !ContextMenuRunsImmediately}" />
                        <TextBlock Text="The window opens with the files listed. Nothing is written until you say so."
                                   FontSize="11" Margin="26,0,0,6"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                        <RadioButton GroupName="Ctx" Content="Start decrypting straight away"
                                     IsChecked="{Binding ContextMenuRunsImmediately}" />
                        <TextBlock Text="Decrypted copies are written immediately, without asking. The window only appears if a password is needed or something fails."
                                   FontSize="11" Margin="26,0,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox Content="Tell me when a new version is available"
                              IsChecked="{Binding CheckForUpdates}" />
                    <TextBlock Text="Checks GitHub once a day. Nothing is downloaded or installed."
                               FontSize="11" Margin="26,-12,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding SettingsFilePath, StringFormat='Settings are stored at {0}'}"
                               FontSize="11" Foreground="{DynamicResource FaintTextBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Passwords: the toggle now, the rule list with feature 0002 -->
            <ScrollViewer IsVisible="{Binding IsPasswords}" Padding="22,20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Passwords" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Remember passwords per folder"
                              IsChecked="{Binding PasswordStoreEnabled}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Files kept in a folder of the same name reuse its password, so statements filed by year keep working as the year changes. Passwords are held in the system keychain, never in a settings file. Folders are only remembered while this is switched on." />
                    <TextBlock Text="{Binding SecureStoreNotice}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintTextBrush}" />
                    <Button Content="Saved folders…" Command="{Binding OpenDetailCommand}"
                            CommandParameter="Saved folders" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding RuleNotice}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningTextBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!-- qpdf status block: a fact, displayed, not a setting to tick -->
            <ScrollViewer IsVisible="{Binding IsQpdf}" Padding="22,20">
                <StackPanel Spacing="14">
                    <TextBlock Text="qpdf" FontSize="18" FontWeight="SemiBold" />

                    <Border Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="6" Padding="12"
                            IsVisible="{Binding !IsQpdfUsable}">
                        <TextBlock Text="{Binding QpdfOrigin}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </Border>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" >
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="✓" FontSize="18" FontWeight="Bold"
                                   Foreground="#3FA45B" Margin="0,0,10,0" IsVisible="{Binding IsQpdfUsable}" />
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="✗" FontSize="18" FontWeight="Bold"
                                   Foreground="#E5534B" Margin="0,0,10,0" IsVisible="{Binding !IsQpdfUsable}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QpdfStatus}" FontWeight="Medium" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QpdfOrigin}" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding IsQpdfUsable}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QpdfPathText}" FontSize="11"
                                   Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="ChooseQpdfButton" Content="Change…" />
                        <Button Content="Re-detect" Command="{Binding RedetectQpdfCommand}" />
                    </StackPanel>

                    <TextBlock IsVisible="{Binding IsBatchRunning}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningTextBrush}"
                               Text="A batch is running. A different qpdf will be used from the next run onwards." />
                </StackPanel>
            </ScrollViewer>

            <!-- Licences: populated by feature 0005 -->
            <ScrollViewer IsVisible="{Binding IsLicences}" Padding="22,20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Licences" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="PDF Unlock is MIT licensed. It depends on qpdf (Apache 2.0), Avalonia, and the .NET runtime. The full list of dependencies and their licence texts is generated at build time and will appear here." />
                </StackPanel>
            </ScrollViewer>

            <!-- Pushed detail page, overlaying whichever section opened it -->
            <Border IsVisible="{Binding IsDetailOpen}" Background="{DynamicResource SystemRegionBrush}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="14,14,0,0">
                        <Button Content="‹ Back" Command="{Binding CloseDetailCommand}" />
                        <TextBlock Text="{Binding DetailPageTitle}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Padding="22,14">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding MatchingExample}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <StackPanel Spacing="6" IsVisible="{Binding HasRules}">
                                <TextBlock Text="Saved" FontWeight="Medium" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:DirectoryPasswordRule">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,3"
                                                  ToolTip.Tip="{Binding OriginPath}">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FolderName}" />
                                                    <TextBlock Text="{Binding OriginPath}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource FaintTextBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Forget" FontSize="11"
                                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).DeleteRuleCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock IsVisible="{Binding !HasRules}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Nothing saved yet. After a run, PDF Unlock offers to remember the passwords that worked." />

                            <StackPanel Spacing="6" IsVisible="{Binding HasCandidates}">
                                <TextBlock Text="Folders seen recently" FontWeight="Medium" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding Candidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:FolderCandidate">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,3"
                                                  ToolTip.Tip="{Binding Path}">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FolderName}" />
                                                    <TextBlock Text="{Binding Path}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource FaintTextBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Dismiss" FontSize="11"
                                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).DismissCandidateCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Button Content="Forget all saved passwords" Command="{Binding ForgetAllCommand}"
                                    IsVisible="{Binding HasRules}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Panel>
    </Grid>

    <Window.Styles>
        <Style Selector="RadioButton.rail">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
    </Window.Styles>
</Window>
