<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PdfUnlock.ViewModels"
        xmlns:m="using:PdfUnlock.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="420"
        x:Class="PdfUnlock.Views.SavePasswordsWindow"
        x:DataType="vm:SavePasswordsViewModel"
        Icon="/Assets/pdf-unlock.ico"
        Width="560" Height="420" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Title="Remember passwords">

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
            <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Explanation}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                CornerRadius="4">
            <ListBox ItemsSource="{Binding Candidates}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="m:PasswordSaveCandidate">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{Binding Path}">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding CanSave}" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Masked}" FontFamily="monospace"
                                       VerticalAlignment="Center" Margin="10,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding Outcome}" FontSize="11"
                                       VerticalAlignment="Center" Width="52"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="{Binding ResultText}" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Button Grid.Column="1" Name="NotNowButton" Content="Not now" />
            <Button Grid.Column="2" Name="SaveButton" Content="Remember" Classes="accent" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</Window>
