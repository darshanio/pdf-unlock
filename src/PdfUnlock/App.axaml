<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfUnlock.App"
             xmlns:local="using:PdfUnlock"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- Semantic colours, defined per theme variant. The app must read correctly in both:
         the system theme is not ours to choose. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="FaintTextBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="SeparatorBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF3CD" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#7A4E00" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A6A6A6" />
                    <SolidColorBrush x:Key="FaintTextBrush" Color="#7C7C7C" />
                    <SolidColorBrush x:Key="SeparatorBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#3A2E10" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#F0C36D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>